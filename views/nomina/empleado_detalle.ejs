<%# views/nomina/empleado_detalle.ejs %>

<!-- Cabecera con información del empleado -->
<div class="card card-custom gutter-b">
    <div class="card-body">
        <div class="d-flex align-items-center">
            <div class="symbol symbol-60 symbol-xxl-100 mr-5 align-self-start align-self-xxl-center">
                <div class="symbol-label" style="background-image:url('/assets/media/users/blank.png')"></div>
            </div>
            <div>
                <a href="#" class="font-weight-bolder font-size-h5 text-dark-75 text-hover-primary">
                    <%= empleado.nombres %> <%= empleado.apellidos %>
                </a>
                <div class="text-muted"><%= empleado.cargo.nombre %></div>
                <div class="mt-2">
                    <span class="label label-inline label-light-primary font-weight-bold">Documento: <%= empleado.documento %></span>
                    <span class="label label-inline label-light-info font-weight-bold">Sector: <%= empleado.sector.nombre_comercial %></span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Pestañas de Navegación -->
<ul class="nav nav-tabs nav-tabs-line">
    <li class="nav-item">
        <a class="nav-link active" data-toggle="tab" href="#tab_datos_personales">Datos Personales</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-toggle="tab" href="#tab_contratos">Contratos</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-toggle="tab" href="#tab_horarios">Horarios</a>
    </li>
</ul>

<!-- Contenido de las Pestañas -->
<div class="tab-content mt-5">

    <!-- ======================= PESTAÑA 1: DATOS PERSONALES ======================= -->
    <div class="tab-pane fade show active" id="tab_datos_personales" role="tabpanel">
        <div class="card card-custom">
            <div class="card-header">
                <div class="card-title">
                    <h3 class="card-label">Información del Empleado</h3>
                </div>
            </div>
            <form class="form" action="/nomina/empleado/editar/<%= empleado._id %>" method="POST">
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-lg-6">
                            <label>Nombres:*</label>
                            <input type="text" name="nombres" class="form-control" value="<%= empleado.nombres %>" required>
                        </div>
                        <div class="col-lg-6">
                            <label>Apellidos:*</label>
                            <input type="text" name="apellidos" class="form-control" value="<%= empleado.apellidos %>" required>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-lg-4">
                            <label>Documento de Identidad:*</label>
                            <input type="text" name="documento" class="form-control" value="<%= empleado.documento %>" required>
                        </div>
                        <div class="col-lg-4">
                            <label>Correo Electrónico:</label>
                            <input type="email" name="correo" class="form-control" value="<%= empleado.correo || '' %>">
                        </div>
                        <div class="col-lg-4">
                            <label>Teléfono:</label>
                            <input type="text" name="telefono" class="form-control" value="<%= empleado.telefono || '' %>">
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-lg-4">
                            <label>Fecha de Ingreso:*</label>
                            <input type="date" name="fecha_ingreso" class="form-control" value="<%= empleado.fecha_ingreso.toISOString().split('T')[0] %>" required>
                        </div>
                        <div class="col-lg-4">
                             <label>Cargo:*</label>
                             <select name="cargo" class="form-control" required>
                                <% cargos.forEach(c => { %>
                                    <option value="<%= c._id %>" <%= (empleado.cargo && empleado.cargo._id.toString() === c._id.toString()) ? 'selected' : '' %>>
                                        <%= c.nombre %>
                                    </option>
                                <% }) %>
                             </select>
                        </div>
                        <div class="col-lg-4">
                            <label>Estado:*</label>
                            <select name="estado" class="form-control">
                                <option value="ACTIVO" <%= empleado.estado === 'ACTIVO' ? 'selected' : '' %>>ACTIVO</option>
                                <option value="INACTIVO" <%= empleado.estado === 'INACTIVO' ? 'selected' : '' %>>INACTIVO</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group row">
                         <div class="col-lg-6">
                            <label>Vincular Usuario del Sistema (Opcional):</label>
                            <select name="usuario" class="form-control">
                                <option value="">-- Sin vincular --</option>
                                <% usuarios.forEach(u => { %>
                                    <option value="<%= u._id %>" <%= (empleado.usuario && empleado.usuario._id.toString() === u._id.toString()) ? 'selected' : '' %>>
                                        <%= u.name %> (<%= u.correo %>)
                                    </option>
                                <% }) %>
                            </select>
                            <span class="form-text text-muted">Permite que el empleado acceda al sistema con su propio usuario y contraseña.</span>
                         </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary mr-2">Guardar Cambios</button>
                    <a href="/nomina/empleados" class="btn btn-secondary">Volver al Listado</a>
                </div>
            </form>
        </div>
    </div>

    <!-- ======================= PESTAÑA 2: CONTRATOS ======================= -->
    <div class="tab-pane fade" id="tab_contratos" role="tabpanel">
        <div class="card card-custom">
            <div class="card-header">
                <div class="card-title">
                    <h3 class="card-label">Historial de Contratos</h3>
                </div>
                <div class="card-toolbar">
                    <button class="btn btn-primary font-weight-bolder" data-toggle="modal" data-target="#modalNuevoContrato">
                        <i class="la la-plus"></i> Nuevo Contrato
                    </button>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <thead><tr><th>Tipo</th><th>Salario</th><th>Periodicidad</th><th>Inicio</th><th>Fin</th><th>Estado</th><th>Acciones</th></tr></thead>
                    <tbody>
                        <% contratos.forEach(c => { %>
                            <tr>
                                <td><%= c.tipo %></td>
                                <td>
                                    <% if(c.tipo === 'POR_HORAS') { %>
                                        $<%= c.salario_por_hora.toFixed(2) %> / hora
                                    <% } else { %>
                                        $<%= c.salario_base_mensual.toFixed(2) %> / mes
                                    <% } %>
                                </td>
                                <td><%= c.periodicidad %></td>
                                <td><%= new Date(c.inicio).toLocaleDateString() %></td>
                                <td><%= c.fin ? new Date(c.fin).toLocaleDateString() : 'Indefinido' %></td>
                                <td><span class="label label-<%= c.activo ? 'success' : 'danger' %> label-inline"><%= c.activo ? 'Activo' : 'Inactivo' %></span></td>
                                <td><a href="/nomina/contrato/eliminar/<%= c._id %>" class="btn btn-sm btn-clean btn-icon btn-eliminar" title="Eliminar"><i class="la la-trash"></i></a></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <!-- ======================= PESTAÑA 3: HORARIOS ======================= -->
    <div class="tab-pane fade" id="tab_horarios" role="tabpanel">
        <!-- Lógica similar a la pestaña de contratos para listar y crear horarios -->
    </div>

</div>


<!-- ======================= MODAL NUEVO CONTRATO ======================= -->
<div class="modal fade" id="modalNuevoContrato" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Crear Nuevo Contrato</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><i class="ki ki-close"></i></button>
            </div>
            <form class="form" action="/nomina/contrato" method="POST">
                <input type="hidden" name="empleado" value="<%= empleado._id %>">
                <div class="modal-body">
                    <div class="form-group row">
                        <div class="col-lg-6">
                            <label>Tipo de Contrato:*</label>
                            <select name="tipo" class="form-control" required>
                                <option value="FIJO">Término Fijo</option>
                                <option value="INDEFINIDO">Término Indefinido</option>
                                <option value="POR_HORAS">Por Horas</option>
                            </select>
                        </div>
                        <div class="col-lg-6">
                             <label>Periodicidad de Pago:*</label>
                            <select name="periodicidad" class="form-control" required>
                                <option value="MENSUAL">Mensual</option>
                                <option value="QUINCENAL">Quincenal</option>
                                <option value="SEMANAL">Semanal</option>
                            </select>
                        </div>
                    </div>
                     <div class="form-group row">
                        <div class="col-lg-6">
                            <label>Salario Base Mensual:</label>
                            <input type="number" step="0.01" name="salario_base_mensual" class="form-control" placeholder="0.00">
                        </div>
                        <div class="col-lg-6">
                             <label>Salario por Hora:</label>
                            <input type="number" step="0.01" name="salario_por_hora" class="form-control" placeholder="0.00">
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-lg-6">
                            <label>Fecha de Inicio:*</label>
                            <input type="date" name="inicio" class="form-control" required>
                        </div>
                        <div class="col-lg-6">
                            <label>Fecha de Fin (si aplica):</label>
                            <input type="date" name="fin" class="form-control">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary font-weight-bold">Guardar Contrato</button>
                </div>
            </form>
        </div>
    </div>
</div>