<%- include("../templantes/cabecera", { titulo: 'Configuración Base de Nómina' }) %>

<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <div class="d-flex flex-column-fluid">
        <div class="container">
            <div class="card card-custom">
                <div class="card-header card-header-tabs-line">
                    <div class="card-title">
                        <h3 class="card-label">Panel de Configuración Base</h3>
                    </div>
                    <div class="card-toolbar">
                        <ul class="nav nav-tabs nav-bold nav-tabs-line">
                            <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#tab_sectores">Sectores</a></li>
                            <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab_cargos">Cargos</a></li>
                            <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab_feriados">Feriados</a></li>
                            <li class="nav-item">
                            <a class="nav-link" data-toggle="tab" href="#tab_horarios">
                                <span class="nav-icon"><i class="flaticon-time-3"></i></span>
                                <span class="nav-text">Horarios</span>
                            </a>
                        </li>
                        </ul>
                    </div>
                </div>
                <div class="card-body">
                    <div class="tab-content">

                        <!-- ======================= PESTAÑA 1: SECTORES ======================= -->
                        <div class="tab-pane fade show active" id="tab_sectores" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-5">
                                <h3 class="card-label"><span class="d-block text-muted pt-2 font-size-sm">Administración de sedes, reglas de negocio y zonas horarias.</span></h3>
                                <button type="button" class="btn btn-primary font-weight-bolder" data-toggle="modal" data-target="#modalNuevoSector"><i class="la la-plus"></i> Nuevo Sector</button>
                            </div>
                            <table class="table table-bordered table-hover table-checkable datatable" id="kt_datatable_sectores">
                                <thead>
                                    <tr><th>Estado</th><th>Nombre Comercial</th><th>País</th><th>Moneda</th><th>Jornada (H)</th><th>Acciones</th></tr>
                                </thead>
                                <tbody>
                                    <% sectores.forEach(s => { %>
                                        <tr class="<%= !s.activo ? 'table-secondary opacity-75' : '' %>">
                                            <td><span class="label label-<%= s.activo ? 'success' : 'danger' %> label-inline"><%= s.activo ? 'Activo' : 'Inactivo' %></span></td>
                                            <td><%= s.nombre_comercial %></td><td><%= s.pais_iso2 %></td><td><%= s.moneda_iso3 %></td>
                                            <td><%= (s.reglas_horas && s.reglas_horas.horas_jornada_diaria) ? s.reglas_horas.horas_jornada_diaria : 'N/A' %></td>
                                            <td nowrap="nowrap">
                                                <a href="javascript:;" class="btn btn-sm btn-clean btn-icon" title="Editar Sector" data-toggle="modal" data-target="#modalEditarSector" data-id="<%= s._id %>"><i class="la la-edit"></i></a>
                                                <a href="/nomina/sector/alternar-estado/<%= s._id %>" class="btn btn-sm btn-clean btn-icon btn-eliminar" title="<%= s.activo ? 'Desactivar Sector' : 'Reactivar Sector' %>"><i class="la <%= s.activo ? 'la-trash text-danger' : 'la-undo text-primary' %>"></i></a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <!-- ======================= PESTAÑA 2: CARGOS ======================= -->
                        <div class="tab-pane fade" id="tab_cargos" role="tabpanel">
                             <div class="d-flex justify-content-between align-items-center mb-5">
                                <h3 class="card-label"><span class="d-block text-muted pt-2 font-size-sm">Catálogo de puestos de trabajo de la organización.</span></h3>
                                <button type="button" class="btn btn-primary font-weight-bolder" data-toggle="modal" data-target="#modalCrearCargo">
                                    <i class="la la-plus"></i> Nuevo Cargo
                                </button>
                            </div>
                            <table class="table table-bordered table-hover table-checkable datatable" id="kt_datatable_cargos">
                                <thead><tr><th>Nombre</th><th>Descripción</th><th>Nivel</th><th>Acciones</th></tr></thead>
                                <tbody>
                                    <% cargos.forEach(cargo => { %>
                                        <tr>
                                            <td><%= cargo.nombre %></td><td><%= cargo.descripcion || 'N/A' %></td><td><%= cargo.nivel_jerarquico %></td>
                                            <td nowrap="nowrap"><a href="javascript:;" class="btn btn-sm btn-clean btn-icon" data-toggle="modal" data-target="#modalEditarCargo" data-id="<%= cargo._id %>" data-nombre="<%= cargo.nombre %>" data-descripcion="<%= cargo.descripcion || '' %>" data-nivel="<%= cargo.nivel_jerarquico %>" title="Editar Cargo"><i class="la la-edit"></i></a><a href="/nomina/cargo/eliminar/<%= cargo._id %>" class="btn btn-sm btn-clean btn-icon btn-eliminar" title="Eliminar Cargo"><i class="la la-trash"></i></a></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <!-- ======================= PESTAÑA 3: FERIADOS ======================= -->
                        <div class="tab-pane fade" id="tab_feriados" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-5">
                                <h3 class="card-label"><span class="d-block text-muted pt-2 font-size-sm">Administración de días no laborables por sector.</span></h3>
                                <button type="button" class="btn btn-primary font-weight-bolder" data-toggle="modal" data-target="#modalNuevoFeriado"><i class="la la-plus"></i> Añadir Feriado</button>
                            </div>
                            <table class="table table-bordered table-hover table-checkable datatable" id="kt_datatable_feriados">
                                <thead><tr><th>Fecha</th><th>Descripción</th><th>Sector</th><th>Acciones</th></tr></thead>
                                <tbody>
                                    <% feriados.forEach(f => { %>
                                        <tr>
                                            <td><%= new Date(f.fecha).toLocaleDateString('es-ES', { timeZone: 'UTC' }) %></td><td><%= f.descripcion %></td><td><%= f.sector.nombre_comercial %></td>
                                            <td nowrap="nowrap"><a href="/nomina/feriado/eliminar/<%= f._id %>" class="btn btn-sm btn-clean btn-icon btn-eliminar" title="Eliminar Feriado"><i class="la la-trash"></i></a></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                        <!-- Dentro de <div class="tab-content"> -->
                                <!-- ======================= PESTAÑA 4: PLANTILLAS DE HORARIOS ======================= -->
                                <div class="tab-pane fade" id="tab_horarios" role="tabpanel">
                                    <div class="d-flex justify-content-between align-items-center mb-5">
                                        <h3 class="card-label">
                                            <span class="d-block text-muted pt-2 font-size-sm">Plantillas de horarios reutilizables para asignar a los empleados.</span>
                                        </h3>
                                        <button type="button" class="btn btn-primary font-weight-bolder" data-toggle="modal" data-target="#modalNuevaPlantillaHorario">
                                            <i class="la la-plus"></i> Nueva Plantilla de Horario
                                        </button>
                                    </div>
                                    <table class="table table-bordered table-hover table-checkable datatable" id="kt_datatable_horarios">
                                        <thead>
                                            <tr>
                                                <th>Nombre de la Plantilla</th>
                                                <th>Descripción</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% horarioPlantillas.forEach(h => { %>
                                                <tr>
                                                    <td><%= h.nombre_plantilla %></td>
                                                    <td><%= h.descripcion || 'N/A' %></td>
                                                    <td nowrap="nowrap">
                                                        <a href="javascript:;" class="btn btn-sm btn-clean btn-icon" title="Editar"><i class="la la-edit"></i></a>
                                                        <a href="javascript:;" class="btn btn-sm btn-clean btn-icon btn-eliminar" title="Eliminar Plantilla"><i class="la la-trash"></i></a>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODALES PARA SECTORES ================= -->
<div class="modal fade" id="modalNuevoSector" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Crear Nuevo Sector</h5><button type="button" class="close" data-dismiss="modal"><i class="ki ki-close"></i></button></div><form class="form" action="/nomina/sector" method="POST"><div class="modal-body"><h4 class="text-dark font-weight-bold mb-5">Información General</h4><div class="form-group row"><div class="col-lg-6"><label>Nombre Comercial:*</label><input type="text" name="nombre_comercial" class="form-control" required /></div><div class="col-lg-6"><label>Razón Social:*</label><input type="text" name="razon_social" class="form-control" required /></div></div><div class="form-group row"><div class="col-lg-4"><label>País:*</label><div class="input-group"><select class="form-control" name="pais_iso2" id="paisSelect" required><option value="" disabled selected>Seleccionar...</option><% paises.forEach(p => { %><option value="<%= p.iso2 %>"><%= p.nombre %></option><% }) %></select><div class="input-group-append"><button class="btn btn-secondary" type="button" data-toggle="modal" data-target="#modalNuevoPais"><i class="la la-plus"></i></button></div></div></div><div class="col-lg-4"><label>Moneda:*</label><div class="input-group"><select class="form-control" name="moneda_iso3" id="monedaSelect" required><option value="" disabled selected>Seleccionar...</option><% monedas.forEach(m => { %><option value="<%= m.iso3 %>"><%= m.nombre %> (<%= m.iso3 %>)</option><% }) %></select><div class="input-group-append"><button class="btn btn-secondary" type="button" data-toggle="modal" data-target="#modalNuevaMoneda"><i class="la la-plus"></i></button></div></div></div><div class="col-lg-4"><label>Zona Horaria (IANA):*</label><select class="form-control" name="timezone" id="timezoneSelect" required><option value="">Seleccionar...</option></select></div></div><div class="separator separator-dashed my-8"></div><h4 class="text-dark font-weight-bold mb-5">Reglas de Horas</h4><div class="form-group row"><div class="col-lg-3"><label>Jornada Diaria:</label><input type="number" name="reglas_horas[horas_jornada_diaria]" class="form-control" value="8" /></div><div class="col-lg-3"><label>Jornada Semanal:</label><input type="number" name="reglas_horas[horas_jornada_semanal]" class="form-control" value="48" /></div><div class="col-lg-3"><label>Inicio Nocturnidad:</label><input type="text" name="reglas_horas[nocturnidad_inicio]" class="form-control" value="21:00" /></div><div class="col-lg-3"><label>Fin Nocturnidad:</label><input type="text" name="reglas_horas[nocturnidad_fin]" class="form-control" value="06:00" /></div></div><div class="form-group row"><div class="col-lg-4"><label>Mult. Extra Diurna:</label><input type="number" step="0.01" name="reglas_horas[extra_diurna]" class="form-control" value="1.25" /></div><div class="col-lg-4"><label>Mult. Extra Nocturna:</label><input type="number" step="0.01" name="reglas_horas[extra_nocturna]" class="form-control" value="1.35" /></div><div class="col-lg-4"><label>Mult. Extra Festiva:</label><input type="number" step="0.01" name="reglas_horas[extra_festiva]" class="form-control" value="1.50" /></div></div><div class="separator separator-dashed my-8"></div><h4 class="text-dark font-weight-bold mb-5">Reglas de Penalizaciones</h4><div class="form-group row"><div class="col-lg-4"><label>Tolerancia (minutos):</label><input type="number" name="reglas_penalizaciones[tolerancia_minutos]" class="form-control" value="5" /></div><div class="col-lg-4"><label>Descuento Tardanza (por min):</label><input type="number" step="0.01" name="reglas_penalizaciones[tardanza_descuento_por_minuto]" class="form-control" value="0" /></div><div class="col-lg-4"><label>Descuento Falta (días):</label><input type="number" step="0.01" name="reglas_penalizaciones[falta_injustificada_descuento_dias]" class="form-control" value="1" /></div></div></div><div class="modal-footer"><button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-primary font-weight-bold">Guardar</button></div></form></div></div>
</div>
<div class="modal fade" id="modalNuevoPais" tabindex="-1" role="dialog" aria-hidden="true"><div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Añadir País</h5><button type="button" class="close" data-dismiss="modal"><i class="ki ki-close"></i></button></div><form class="form" id="formNuevoPais"><div class="modal-body"><div class="form-group"><label>Nombre:*</label><input type="text" id="nuevoPaisNombre" class="form-control" required /></div><div class="form-group"><label>Código ISO2:*</label><input type="text" id="nuevoPaisISO2" class="form-control" required maxlength="2" /></div></div><div class="modal-footer"><button type="button" class="btn btn-light-primary" data-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-primary">Guardar</button></div></form></div></div></div>
<div class="modal fade" id="modalNuevaMoneda" tabindex="-1" role="dialog" aria-hidden="true"><div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Añadir Moneda</h5><button type="button" class="close" data-dismiss="modal"><i class="ki ki-close"></i></button></div><form class="form" id="formNuevaMoneda"><div class="modal-body"><div class="form-group"><label>Nombre:*</label><input type="text" id="nuevaMonedaNombre" class="form-control" required /></div><div class="form-group"><label>Código ISO3:*</label><input type="text" id="nuevaMonedaISO3" class="form-control" required maxlength="3" /></div></div><div class="modal-footer"><button type="button" class="btn btn-light-primary" data-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-primary">Guardar</button></div></form></div></div></div>
<div class="modal fade" id="modalEditarSector" tabindex="-1" role="dialog" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg" role="document"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Editar Sector</h5><button type="button" class="close" data-dismiss="modal"><i class="ki ki-close"></i></button></div><form class="form" id="formEditarSector" action="" method="POST"><div class="modal-body"><h4 class="text-dark font-weight-bold mb-5">Información General</h4><div class="form-group row"><div class="col-lg-6"><label>Nombre Comercial:*</label><input type="text" id="edit_nombre_comercial" name="nombre_comercial" class="form-control" required /></div><div class="col-lg-6"><label>Razón Social:*</label><input type="text" id="edit_razon_social" name="razon_social" class="form-control" required /></div></div><div class="form-group row"><div class="col-lg-4"><label>País:*</label><select class="form-control" name="pais_iso2" id="edit_paisSelect" required><% paises.forEach(p => { %><option value="<%= p.iso2 %>"><%= p.nombre %></option><% }) %></select></div><div class="col-lg-4"><label>Moneda:*</label><select class="form-control" name="moneda_iso3" id="edit_monedaSelect" required><% monedas.forEach(m => { %><option value="<%= m.iso3 %>"><%= m.nombre %> (<%= m.iso3 %>)</option><% }) %></select></div><div class="col-lg-4"><label>Zona Horaria (IANA):*</label><select class="form-control" name="timezone" id="edit_timezoneSelect" required></select></div></div><div class="separator separator-dashed my-8"></div><h4 class="text-dark font-weight-bold mb-5">Reglas de Horas</h4><div class="form-group row"><div class="col-lg-3"><label>Jornada Diaria:</label><input type="number" id="edit_horas_jornada_diaria" name="reglas_horas[horas_jornada_diaria]" class="form-control" /></div><div class="col-lg-3"><label>Jornada Semanal:</label><input type="number" id="edit_horas_jornada_semanal" name="reglas_horas[horas_jornada_semanal]" class="form-control" /></div><div class="col-lg-3"><label>Inicio Nocturnidad:</label><input type="text" id="edit_nocturnidad_inicio" name="reglas_horas[nocturnidad_inicio]" class="form-control" /></div><div class="col-lg-3"><label>Fin Nocturnidad:</label><input type="text" id="edit_nocturnidad_fin" name="reglas_horas[nocturnidad_fin]" class="form-control" /></div></div><div class="form-group row"><div class="col-lg-4"><label>Mult. Extra Diurna:</label><input type="number" step="0.01" id="edit_extra_diurna" name="reglas_horas[extra_diurna]" class="form-control" /></div><div class="col-lg-4"><label>Mult. Extra Nocturna:</label><input type="number" step="0.01" id="edit_extra_nocturna" name="reglas_horas[extra_nocturna]" class="form-control" /></div><div class="col-lg-4"><label>Mult. Extra Festiva:</label><input type="number" step="0.01" id="edit_extra_festiva" name="reglas_horas[extra_festiva]" class="form-control" /></div></div><div class="separator separator-dashed my-8"></div><h4 class="text-dark font-weight-bold mb-5">Reglas de Penalizaciones</h4><div class="form-group row"><div class="col-lg-4"><label>Tolerancia (minutos):</label><input type="number" id="edit_tolerancia_minutos" name="reglas_penalizaciones[tolerancia_minutos]" class="form-control" /></div><div class="col-lg-4"><label>Descuento Tardanza (por min):</label><input type="number" step="0.01" id="edit_tardanza_descuento_por_minuto" name="reglas_penalizaciones[tardanza_descuento_por_minuto]" class="form-control" /></div><div class="col-lg-4"><label>Descuento Falta (días):</label><input type="number" step="0.01" id="edit_falta_injustificada_descuento_dias" name="reglas_penalizaciones[falta_injustificada_descuento_dias]" class="form-control" /></div></div></div><div class="modal-footer"><button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-primary font-weight-bold">Guardar Cambios</button></div></form></div></div></div>

<!-- ================= MODALES PARA CARGOS ================= -->
<div class="modal fade" id="modalCrearCargo" tabindex="-1" role="dialog" aria-hidden="true"><div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Crear Nuevo Cargo</h5><button type="button" class="close" data-dismiss="modal"><i class="ki ki-close"></i></button></div><form class="form" action="/nomina/cargo" method="POST"><div class="modal-body"><div class="form-group"><label>Nombre:*</label><input type="text" name="nombre" class="form-control" required /></div><div class="form-group"><label>Descripción:</label><textarea name="descripcion" class="form-control" rows="3"></textarea></div><div class="form-group"><label>Nivel Jerárquico:*</label><input type="number" name="nivel_jerarquico" class="form-control" value="1" min="1" required /></div></div><div class="modal-footer"><button type="button" class="btn btn-light-primary" data-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-primary">Guardar</button></div></form></div></div></div>
<div class="modal fade" id="modalEditarCargo" tabindex="-1" role="dialog" aria-hidden="true"><div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Editar Cargo</h5><button type="button" class="close" data-dismiss="modal"><i class="ki ki-close"></i></button></div><form class="form" id="formEditarCargo" action="" method="POST"><div class="modal-body"><div class="form-group"><label>Nombre:*</label><input type="text" name="nombre" id="editNombre" class="form-control" required /></div><div class="form-group"><label>Descripción:</label><textarea name="descripcion" id="editDescripcion" class="form-control" rows="3"></textarea></div><div class="form-group"><label>Nivel Jerárquico:*</label><input type="number" name="nivel_jerarquico" id="editNivel" class="form-control" min="1" required /></div></div><div class="modal-footer"><button type="button" class="btn btn-light-primary" data-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-primary">Actualizar</button></div></form></div></div></div>

<!-- ================= MODALES PARA FERIADOS ================= -->
<div class="modal fade" id="modalNuevoFeriado" tabindex="-1" role="dialog" aria-hidden="true"><div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Añadir Feriado</h5><button type="button" class="close" data-dismiss="modal"><i class="ki ki-close"></i></button></div><form action="/nomina/feriado" method="POST"><div class="modal-body"><div class="form-group"><label>Sector:*</label><select name="sector" class="form-control" required><option value="">Seleccione...</option><% sectores.forEach(s => { %><option value="<%= s._id %>"><%= s.nombre_comercial %></option><% }) %></select></div><div class="form-group"><label>Fecha:*</label><input type="date" name="fecha" class="form-control" required /></div><div class="form-group"><label>Descripción:*</label><input type="text" name="descripcion" class="form-control" required /></div></div><div class="modal-footer"><button type="button" class="btn btn-light-primary" data-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-primary">Guardar</button></div></form></div></div></div>

<!-- ================= MODAL NUEVA PLANTILLA DE HORARIO ================= -->
<div class="modal fade" id="modalNuevaPlantillaHorario" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Crear Nueva Plantilla de Horario</h5>
                <button type="button" class="close" data-dismiss="modal"><i class="ki ki-close"></i></button>
            </div>
            <form class="form" action="/nomina/horario-plantilla" method="POST">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Nombre de la Plantilla:*</label>
                        <input type="text" name="nombre_plantilla" class="form-control" placeholder="Ej: Turno de Oficina L-V" required />
                    </div>
                    <div class="form-group">
                        <label>Descripción:</label>
                        <textarea name="descripcion" class="form-control" rows="2" placeholder="Ej: Horario de 8am a 5pm con 1 hora de almuerzo."></textarea>
                    </div>
                    <div class="separator separator-dashed my-5"></div>
                    <h5 class="text-dark font-weight-bold mb-4">Definición de Turnos Semanales</h5>

                    <% const dias = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado']; %>
                    <% for(let i = 0; i < 7; i++) { %>
                    <div class="form-group row align-items-center">
                        <div class="col-lg-2">
                            <label class="font-weight-bold"><%= dias[i] %></label>
                            <input type="hidden" name="turnos[<%= i %>][dia_semana]" value="<%= i %>">
                        </div>
                        <div class="col-lg-3">
                            <label>Inicio:</label>
                            <input type="time" name="turnos[<%= i %>][inicio]" class="form-control" value="08:00">
                        </div>
                        <div class="col-lg-3">
                            <label>Fin:</label>
                            <input type="time" name="turnos[<%= i %>][fin]" class="form-control" value="17:00">
                        </div>
                        <div class="col-lg-4">
                            <label>Descanso (minutos):</label>
                            <input type="number" name="turnos[<%= i %>][descanso_min]" class="form-control" value="60">
                        </div>
                    </div>
                    <% } %>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary font-weight-bold">Guardar Plantilla</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include("../templantes/footer") %>
<%- include("../templantes/script_page") %>

<%# ----- SCRIPTS PARA ESTE DASHBOARD ----- %>
<script>
    "use strict";

    jQuery(document).ready(function() {

        // --- INICIALIZADOR GENERAL DE TODAS LAS DATATABLES ---
        // Le asignamos la clase 'datatable' a todas las tablas en los parciales
        // para inicializarlas de una sola vez.
        $('.datatable').DataTable({
            responsive: true,
            language: { 
                "url": "https://cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
            },
            "order": [] // Desactiva el ordenamiento inicial automático
        });

        // --- LÓGICA PARA LA PESTAÑA "SECTORES" ---
        (function initSectoresScripts() {
            // Cargar zonas horarias en ambos modales de Sector (Nuevo y Editar)
            $('#modalNuevoSector, #modalEditarSector').on('show.bs.modal', function () {
                const timezoneSelect = $(this).find('select[name="timezone"]');
                if (timezoneSelect.children('option').length <= 1) { 
                    timezoneSelect.html('<option value="">Cargando...</option>');
                    try {
                        if (moment && moment.tz) {
                            const timezones = moment.tz.names().filter(tz => tz.includes('/'));
                            const userTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
                            if (timezones.indexOf(userTimezone) > -1) {
                                timezones.splice(timezones.indexOf(userTimezone), 1);
                            }
                            timezones.unshift(userTimezone);
                            
                            timezoneSelect.html('<option value="" disabled selected>Seleccione...</option>');
                            timezones.forEach(tz => timezoneSelect.append(new Option(tz, tz)));
                        }
                    } catch (e) { console.error("Error al cargar Moment Timezone:", e); }
                }
            });

            // Lógica MEJORADA para el modal "Nuevo País"
            $('#formNuevoPais').on('submit', function(e) {
                e.preventDefault();
                const form = $(this);
                const nombre = $('#nuevoPaisNombre').val().trim();
                const iso2 = $('#nuevoPaisISO2').val().trim().toUpperCase();
                if (!nombre || !iso2) return;

                fetch('/nomina/pais', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ nombre: nombre, iso2: iso2 }) })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const newOption = new Option(data.pais.nombre + ' (' + data.pais.iso2 + ')', data.pais.iso2, true, true);
                        $('#paisSelect').append(newOption).trigger('change');
                        $('#modalNuevoPais').modal('hide');
                        form[0].reset();
                        Swal.fire("¡Éxito!", "País '" + nombre + "' guardado.", "success");
                    } else {
                        Swal.fire("Error", "No se pudo guardar el país. " + (data.message || 'Error desconocido.'), "error");
                    }
                })
                .catch(err => Swal.fire("Error", "Ocurrió un problema de conexión.", "error"));
            });

            // Lógica MEJORADA para el modal "Nueva Moneda"
            $('#formNuevaMoneda').on('submit', function(e) {
                e.preventDefault();
                const form = $(this);
                const nombre = $('#nuevaMonedaNombre').val().trim();
                const iso3 = $('#nuevaMonedaISO3').val().trim().toUpperCase();
                if (!nombre || !iso3) return;

                fetch('/nomina/moneda', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ nombre: nombre, iso3: iso3 }) })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const newOption = new Option(data.moneda.nombre + ' (' + data.moneda.iso3 + ')', data.moneda.iso3, true, true);
                        $('#monedaSelect').append(newOption).trigger('change');
                        $('#modalNuevaMoneda').modal('hide');
                        form[0].reset();
                        Swal.fire("¡Éxito!", "Moneda '" + nombre + "' guardada.", "success");
                    } else {
                        Swal.fire("Error", "No se pudo guardar la moneda. " + (data.message || 'Error desconocido.'), "error");
                    }
                })
                .catch(err => Swal.fire("Error", "Ocurrió un problema de conexión.", "error"));
            });

            // LÓGICA MEJORADA PARA LLENAR EL MODAL DE EDICIÓN DE SECTOR
            $('#modalEditarSector').on('show.bs.modal', function(event) {
                const button = $(event.relatedTarget);
                const id = button.data('id');
                const modal = $(this);
                modal.find('form').attr('action', '/nomina/sector/editar/' + id);

                // Mostramos un loader mientras se cargan los datos
                modal.find('.modal-body').hide();
                // (Opcional: puedes añadir un spinner de carga aquí)

                fetch('/nomina/sector/' + id)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            const sector = data.sector;
                            const r_horas = sector.reglas_horas || {};
                            const r_penal = sector.reglas_penalizaciones || {};

                            // Llenamos el formulario
                            modal.find('#edit_nombre_comercial').val(sector.nombre_comercial);
                            modal.find('#edit_razon_social').val(sector.razon_social);
                            
                            // Llenamos y seleccionamos los selects
                            modal.find('#edit_paisSelect').val(sector.pais_iso2);
                            modal.find('#edit_monedaSelect').val(sector.moneda_iso3);
                            modal.find('#edit_timezoneSelect').val(sector.timezone);
                            
                            modal.find('#edit_horas_jornada_diaria').val(r_horas.horas_jornada_diaria);
                            modal.find('#edit_horas_jornada_semanal').val(r_horas.horas_jornada_semanal);
                            modal.find('#edit_nocturnidad_inicio').val(r_horas.nocturnidad_inicio);
                            modal.find('#edit_nocturnidad_fin').val(r_horas.nocturnidad_fin);
                            modal.find('#edit_extra_diurna').val(r_horas.extra_diurna);
                            modal.find('#edit_extra_nocturna').val(r_horas.extra_nocturna);
                            modal.find('#edit_extra_festiva').val(r_horas.extra_festiva);
                            
                            modal.find('#edit_tolerancia_minutos').val(r_penal.tolerancia_minutos);
                            modal.find('#edit_tardanza_descuento_por_minuto').val(r_penal.tardanza_descuento_por_minuto);
                            modal.find('#edit_falta_injustificada_descuento_dias').val(r_penal.falta_injustificada_descuento_dias);

                            modal.find('.modal-body').show(); // Mostramos el formulario ya poblado
                        } else {
                            Swal.fire("Error", data.message || "No se pudo cargar la información del sector.", "error");
                            modal.modal('hide');
                        }
                    })
                    .catch(err => {
                        Swal.fire("Error de Conexión", "No se pudo contactar al servidor para obtener los datos.", "error");
                        modal.modal('hide');
                    });
            });
        })();

        // --- LÓGICA PARA LA PESTAÑA "CARGOS" ---
        (function initCargosScripts() {
            $('#modalEditarCargo').on('show.bs.modal', function (event) {
                const button = $(event.relatedTarget);
                const modal = $(this);
                modal.find('form').attr('action', '/nomina/cargo/editar/' + button.data('id'));
                modal.find('#editNombre').val(button.data('nombre'));
                modal.find('#editDescripcion').val(button.data('descripcion'));
                modal.find('#editNivel').val(button.data('nivel'));
            });
        })();

        // --- LÓGICA MEJORADA PARA CONFIRMACIÓN DE ACCIONES ---
        $(document).on('click', '.btn-eliminar', function(e) {
            e.preventDefault();
            const href = $(this).attr('href');
            const title = $(this).attr('title') || '¿Estás seguro?';
            const text = title.toLowerCase().includes('desactivar') 
                ? "El registro se marcará como inactivo." 
                : (title.toLowerCase().includes('reactivar') ? "El registro se volverá a activar." : "¡No podrás revertir esto!");
            
            const confirmButtonText = title.toLowerCase().includes('desactivar') 
                ? 'Sí, ¡desactivar!' 
                : (title.toLowerCase().includes('reactivar') ? 'Sí, ¡reactivar!' : 'Sí, ¡eliminar!');

            Swal.fire({
                title: title + '?',
                text: text,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: confirmButtonText,
                cancelButtonText: 'Cancelar'
            }).then((result) => { if (result.isConfirmed) { window.location.href = href; } });
        });
        
        // --- LÓGICA PARA MANEJAR LAS PESTAÑAS (TABS) ---
        (function initTabManagement() {
            let hash = window.location.hash;
            if (hash) {
                $('.nav-tabs a[href="' + hash + '"]').tab('show');
            }
            $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
                window.location.hash = e.target.hash;
                $($.fn.dataTable.tables(true)).DataTable().columns.adjust().responsive.recalc();
            });
        })();
    });
</script>