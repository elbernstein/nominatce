<%- include("../templantes/cabecera", { titulo: titulo }) %>

<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <div class="d-flex flex-column-fluid">
        <div class="container">
            <!--begin::Card (Cabecera del Perfil)-->
            <div class="card card-custom gutter-b">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="symbol symbol-60 symbol-xxl-100 mr-5">
                            <div class="symbol-label" style="background-image:url('/assets/media/users/blank.png')"></div>
                        </div>
                        <div>
                            <h2 class="font-weight-bolder text-dark-75"><%= empleado.nombres %> <%= empleado.apellidos %></h2>
                            <div class="text-muted"><%= empleado.cargo.nombre %></div>
                            <div class="mt-2">
                                <span class="label label-inline label-light-primary font-weight-bold">Documento: <%= empleado.documento %></span>
                                <span class="label label-inline label-light-info font-weight-bold">Sector: <%= empleado.sector.nombre_comercial %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!--end::Card-->

            <!--begin::Card (Contenido con Pestañas)-->
            <div class="card card-custom">
                <div class="card-header card-header-tabs-line">
                    <div class="card-toolbar">
                        <ul class="nav nav-tabs nav-bold nav-tabs-line">
                            <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#tab_datos_personales">Datos Personales</a></li>
                            <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab_contratos">Contratos</a></li>
                            <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab_horarios">Horarios</a></li>
                        </ul>
                    </div>
                </div>

                <div class="card-body">
                    <div class="tab-content">
                        <!-- ================= PESTAÑA 1: DATOS PERSONALES ================= -->
                        <div class="tab-pane fade show active" id="tab_datos_personales" role="tabpanel">
                            <form class="form" action="/nomina/personal/editar/<%= empleado._id %>" method="POST">
                                <div class="card-body">
                                    <h4 class="text-dark font-weight-bold mb-5">Información Básica</h4>
                                    <div class="form-group row">
                                        <div class="col-lg-6"><label>Nombres:*</label><input type="text" name="nombres" class="form-control" value="<%= empleado.nombres %>" required></div>
                                        <div class="col-lg-6"><label>Apellidos:*</label><input type="text" name="apellidos" class="form-control" value="<%= empleado.apellidos %>" required></div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-lg-6"><label>Documento:*</label><input type="text" name="documento" class="form-control" value="<%= empleado.documento %>" required></div>
                                        <div class="col-lg-6"><label>Fecha Ingreso:*</label><input type="date" name="fecha_ingreso" class="form-control" value="<%= new Date(empleado.fecha_ingreso).toISOString().split('T')[0] %>" required></div>
                                    </div>
                                    <div class="separator separator-dashed my-8"></div>
                                    <h4 class="text-dark font-weight-bold mb-5">Asignación y Estado</h4>
                                    <div class="form-group row">
                                        <div class="col-lg-4"><label>Sector (Empresa/País):*</label><select class="form-control" name="sector" required><% sectores.forEach(s => { %><option value="<%= s._id %>" <%= (empleado.sector && empleado.sector._id.toString() === s._id.toString()) ? 'selected' : '' %>><%= s.nombre_comercial %></option><% }) %></select></div>
                                        <div class="col-lg-4"><label>Cargo:*</label><select name="cargo" class="form-control" required><% cargos.forEach(c => { %><option value="<%= c._id %>" <%= (empleado.cargo && empleado.cargo._id.toString() === c._id.toString()) ? 'selected' : '' %>><%= c.nombre %></option><% }) %></select></div>
                                        <div class="col-lg-4"><label>Estado:*</label><select name="estado" class="form-control" required><option value="ACTIVO" <%= empleado.estado === 'ACTIVO' ? 'selected' : '' %>>Activo</option><option value="INACTIVO" <%= empleado.estado === 'INACTIVO' ? 'selected' : '' %>>Inactivo</option></select></div>
                                    </div>
                                     <div class="form-group row">
                                        <div class="col-lg-12"><label>Vincular Usuario del Sistema:</label><select name="usuario" class="form-control"><option value="">-- Sin Vincular --</option><% usuarios.forEach(u => { %><option value="<%= u._id %>" <%= (empleado.usuario && empleado.usuario._id.toString() === u._id.toString()) ? 'selected' : '' %>><%= u.name %> (<%= u.correo %>)</option><% }) %></select></div>
                                    </div>
                                </div>
                                <div class="card-footer d-flex justify-content-between"><a href="/nomina/personal" class="btn btn-secondary">Volver al Listado</a><button type="submit" class="btn btn-primary">Guardar Cambios</button></div>
                            </form>
                        </div>
<!-- ================= PESTAÑA 2: CONTRATOS (MODO LECTURA) ================= -->
<div class="tab-pane fade" id="tab_contratos" role="tabpanel">
    
    <% if (empleado.contrato) { %>
        <!-- Si el empleado TIENE un contrato asignado -->
        <h4 class="text-dark font-weight-bold mb-5">Contrato Actual del Empleado</h4>
        <div class="form-group row">
            <label class="col-lg-3 col-form-label text-right font-weight-bold">Tipo de Contrato:</label>
            <div class="col-lg-9">
                <p class="form-control-plaintext"><%= empleado.contrato.tipo %></p>
            </div>
        </div>
        <div class="form-group row">
            <label class="col-lg-3 col-form-label text-right font-weight-bold">Periodicidad de Pago:</label>
            <div class="col-lg-9">
                <p class="form-control-plaintext"><%= empleado.contrato.periodicidad %></p>
            </div>
        </div>
        <div class="form-group row">
            <label class="col-lg-3 col-form-label text-right font-weight-bold">Salario Base:</label>
            <div class="col-lg-9">
                <p class="form-control-plaintext"><%= empleado.contrato.salario_base_mensual ? '$' + empleado.contrato.salario_base_mensual.toFixed(2) : 'N/A' %></p>
            </div>
        </div>
        <div class="form-group row">
            <label class="col-lg-3 col-form-label text-right font-weight-bold">Salario por Hora:</label>
            <div class="col-lg-9">
                <p class="form-control-plaintext"><%= empleado.contrato.salario_por_hora ? '$' + empleado.contrato.salario_por_hora.toFixed(2) : 'N/A' %></p>
            </div>
        </div>

        <div class="separator separator-dashed my-8"></div>
        
        <div class="text-right">
            <a href="/nomina/contratos/<%= empleado.contrato._id %>" class="btn btn-light-primary font-weight-bold">
                <i class="la la-cog"></i> Gestionar Asignación de Empleados
            </a>
        </div>
        
    <% } else { %>
        <!-- Si el empleado NO TIENE un contrato asignado -->
        <div class="alert alert-custom alert-light-warning d-flex align-items-center p-5">
            <div class="alert-icon"><i class="flaticon-warning"></i></div>
            <div class="alert-text">
                Este empleado no tiene ningún contrato asignado.
                <br>
                Para asignarle uno, por favor, vaya al <a href="/nomina/personal#tab_contratos" class="font-weight-bold">Catálogo de Contratos</a>, seleccione el contrato deseado y añada a este empleado a la lista de asignados.
            </div>
        </div>
    <% } %>

</div>
                        <!-- ================= PESTAÑA 3: HORARIOS ================= -->
                        <!-- ================= PESTAÑA 3: HORARIOS ================= -->
<!-- ================= PESTAÑA 3: HORARIOS ================= -->
<div class="tab-pane fade" id="tab_horarios" role="tabpanel">
    
    <!-- Sección para Asignar Plantilla -->
    <form class="form" action="/nomina/personal/editar/<%= empleado._id %>" method="POST">
        <div class="card-body px-0 pt-0">
            <h4 class="text-dark font-weight-bold mb-5">Asignación de Horario por Plantilla</h4>
            <div class="form-group row">
                <div class="col-lg-8">
                    <label>Seleccionar Plantilla:</label>
                    <select class="form-control" name="horario_plantilla">
                        <option value="">-- Sin Plantilla Asignada --</option>
                        <% horarioPlantillas.forEach(p => { %>
                            <option value="<%= p._id %>" <%= (empleado.horario_plantilla && empleado.horario_plantilla._id.toString() === p._id.toString()) ? 'selected' : '' %>><%= p.nombre_plantilla %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-lg-4 align-self-end">
                    <button type="submit" class="btn btn-primary">Guardar Asignación</button>
                </div>
            </div>
            <span class="form-text text-muted">Asigna un horario predefinido a este empleado. Esto anulará cualquier horario personalizado que exista.</span>
        </div>
    </form>
    
    <div class="separator separator-dashed my-8"></div>
    
    <!-- Sección para Horario Personalizado -->
    <div class="card-body px-0">
        <h4 class="text-dark font-weight-bold mb-5">Horario Personalizado</h4>
        <p class="text-muted">Use esta opción si el empleado tiene un horario único que no corresponde a una plantilla. Esto tiene prioridad sobre la plantilla asignada.</p>
        <button type="button" class="btn btn-light-info font-weight-bold" data-toggle="modal" data-target="#modalHorarioPersonalizado">
            <%= (empleado.horario_personalizado && empleado.horario_personalizado.length > 0) ? 'Editar Horario Personalizado' : 'Crear Horario Personalizado' %>
        </button>
    </div>

    <div class="separator separator-dashed my-8"></div>
    
    <!-- Sección de Visualización del Horario Activo -->
    <div class="card-body px-0">
        <h5 class="text-dark font-weight-bold mb-4">Detalle del Horario Activo</h5>
        <% if (empleado.horario_personalizado && empleado.horario_personalizado.length > 0) { %>
            <p class="text-info font-weight-bold">Horario activo: PERSONALIZADO.</p>
            <% const turnosActivos = empleado.horario_personalizado; %>
            <table class="table table-bordered">
                 <thead><tr class="table-light"><th>Día</th><th>Inicio</th><th>Fin</th><th>Descanso (min)</th></tr></thead>
                 <tbody>
                    <% const dias = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado']; %>
                    <% for(let i = 0; i < 7; i++) { const turno = turnosActivos.find(t => t.dia_semana === i); %>
                    <tr><td class="font-weight-bold"><%= dias[i] %></td><% if (turno) { %><td><%= turno.inicio %></td><td><%= turno.fin %></td><td><%= turno.descanso_min %></td><% } else { %><td colspan="3" class="text-center text-muted">Día no laborable</td><% } %></tr>
                    <% } %>
                 </tbody>
            </table>
        <% } else if (empleado.horario_plantilla) { %>
            <p class="text-primary font-weight-bold">Horario activo: Plantilla "<%= empleado.horario_plantilla.nombre_plantilla %>"</p>
            <% const turnosActivos = empleado.horario_plantilla.turnos; %>
            <table class="table table-bordered">
                 <thead><tr class="table-light"><th>Día</th><th>Inicio</th><th>Fin</th><th>Descanso (min)</th></tr></thead>
                 <tbody>
                    <% const dias = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado']; %>
                    <% for(let i = 0; i < 7; i++) { const turno = turnosActivos.find(t => t.dia_semana === i); %>
                    <tr><td class="font-weight-bold"><%= dias[i] %></td><% if (turno) { %><td><%= turno.inicio %></td><td><%= turno.fin %></td><td><%= turno.descanso_min %></td><% } else { %><td colspan="3" class="text-center text-muted">Día no laborable</td><% } %></tr>
                    <% } %>
                 </tbody>
            </table>
        <% } else { %>
            <div class="alert alert-info">No hay ningún horario asignado para este empleado.</div>
        <% } %>
    </div>
</div>


                    </div>
                </div>
            </div>
            <!--end::Card-->
        </div>
    </div>
</div>
<!-- ================= MODAL HORARIO PERSONALIZADO ================= -->
<div class="modal fade" id="modalHorarioPersonalizado" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Definir Horario Personalizado para <%= empleado.nombres %></h5><button type="button" class="close" data-dismiss="modal"><i class="ki ki-close"></i></button></div>
            <form class="form" action="/nomina/personal/<%= empleado._id %>/horario-personalizado" method="POST">
                <div class="modal-body">
                    <p class="text-muted">Este horario aplicará únicamente a este empleado y anulará cualquier plantilla asignada. Deje los campos de inicio/fin vacíos para los días no laborables.</p>
                    <div class="separator separator-dashed my-5"></div>
                    <% const dias = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado']; %>
                    <% for(let i = 0; i < 7; i++) { %>
                        <% const turnoExistente = (empleado.horario_personalizado && empleado.horario_personalizado.length > 0) ? empleado.horario_personalizado.find(t => t.dia_semana === i) : null; %>
                        <div class="form-group row align-items-center"><div class="col-lg-2"><label class="font-weight-bold"><%= dias[i] %></label><input type="hidden" name="turnos[<%= i %>][dia_semana]" value="<%= i %>"></div><div class="col-lg-3"><label>Inicio:</label><input type="time" name="turnos[<%= i %>][inicio]" class="form-control" value="<%= turnoExistente ? turnoExistente.inicio : '' %>"></div><div class="col-lg-3"><label>Fin:</label><input type="time" name="turnos[<%= i %>][fin]" class="form-control" value="<%= turnoExistente ? turnoExistente.fin : '' %>"></div><div class="col-lg-4"><label>Descanso (min):</label><input type="number" name="turnos[<%= i %>][descanso_min]" class="form-control" value="<%= turnoExistente ? turnoExistente.descanso_min : 60 %>"></div></div>
                    <% } %>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light-primary" data-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-primary">Guardar Horario Personalizado</button></div>
            </form>
        </div>
    </div>
</div>

<%- include("../templantes/footer") %>
<%- include("../templantes/script_page") %>

<script>
    // No se necesita JS personalizado en esta fase
</script>