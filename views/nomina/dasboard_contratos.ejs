<%- include("../templantes/cabecera", { titulo: titulo }) %>

<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <div class="d-flex flex-column-fluid">
        <div class="container">
            <div class="card card-custom">
                <div class="card-header">
                    <div class="card-title">
                        <h3 class="card-label">Catálogo de Contratos Maestros</h3>
                    </div>
                    <div class="card-toolbar">
                        <button type="button" class="btn btn-primary font-weight-bolder" data-toggle="modal" data-target="#modalNuevoContrato">
                            <i class="la la-plus"></i> Nuevo Contrato Maestro
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-muted">Estos son los contratos base que puede asignar a múltiples empleados. El salario específico y las fechas se definen al momento de la asignación en el perfil de cada empleado.</p>
                    <table class="table table-bordered table-hover table-checkable datatable" id="kt_datatable_contratos">
                        <thead>
                            <tr>
                                <th>Tipo de Contrato</th>
                                <th>Periodicidad de Pago</th>
                                <th>Salario Base (si aplica)</th>
                                <th>Salario por Hora (si aplica)</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% contratos.forEach(c => { %>
                                <tr class="<%= !c.activo ? 'table-secondary opacity-75' : '' %>">
                                    <td><%= c.tipo %></td>
                                    <td><%= c.periodicidad %></td>
                                    <td><%= c.salario_base_mensual ? '$' + c.salario_base_mensual.toFixed(2) : 'N/A' %></td>
                                    <td><%= c.salario_por_hora ? '$' + c.salario_por_hora.toFixed(2) : 'N/A' %></td>
                                    <td><span class="label label-<%= c.activo ? 'success' : 'danger' %> label-inline"><%= c.activo ? 'Activo' : 'Inactivo' %></span></td>
                                    <td nowrap="nowrap">
                                        <a href="/nomina/contratos/<%= c._id %>" class="btn btn-sm btn-clean btn-icon" title="Ver Detalle y Asignar Empleados">
                                            <i class="la la-users"></i>
                                        </a>
                                        <!-- (Aquí añadiremos botones de editar y desactivar después) -->
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL NUEVO CONTRATO MAESTRO ================= -->
<div class="modal fade" id="modalNuevoContrato" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Crear Nuevo Contrato Maestro</h5>
                <button type="button" class="close" data-dismiss="modal"><i class="ki ki-close"></i></button>
            </div>
            <form class="form" action="/nomina/contrato" method="POST">
                <div class="modal-body">
                    <div class="form-group row">
                        <div class="col-lg-6">
                            <label>Tipo de Contrato:*</label>
                            <select name="tipo" class="form-control" required>
                                <option value="FIJO">Fijo</option>
                                <option value="INDEFINIDO">Indefinido</option>
                                <option value="POR_HORAS">Por Horas</option>
                            </select>
                        </div>
                        <div class="col-lg-6">
                            <label>Periodicidad de Pago:*</label>
                            <select name="periodicidad" class="form-control" required>
                                <option value="MENSUAL">Mensual</option>
                                <option value="QUINCENAL">Quincenal</option>
                                <option value="SEMANAL">Semanal</option>
                            </select>
                        </div>
                    </div>
                     <div class="form-group row">
                        <div class="col-lg-6">
                            <label>Salario Base Mensual (si aplica):</label>
                            <div class="input-group"><div class="input-group-prepend"><span class="input-group-text">$</span></div><input type="number" step="0.01" name="salario_base_mensual" class="form-control" placeholder="0.00"></div>
                            <span class="form-text text-muted">Para contratos FIJO o INDEFINIDO.</span>
                        </div>
                        <div class="col-lg-6">
                             <label>Salario por Hora (si aplica):</label>
                             <div class="input-group"><div class="input-group-prepend"><span class="input-group-text">$</span></div><input type="number" step="0.01" name="salario_por_hora" class="form-control" placeholder="0.00"></div>
                             <span class="form-text text-muted">Para contratos POR HORAS.</span>
                        </div>
                    </div>
                     <div class="form-group row">
                        <div class="col-lg-12">
                            <label>Estado Inicial:</label>
                            <select name="activo" class="form-control">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-primary font-weight-bold" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary font-weight-bold">Guardar Contrato</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include("../templantes/footer") %>
<%- include("../templantes/script_page") %>

<script>
    "use strict";
    jQuery(document).ready(function() {
        $('.datatable').DataTable({
            responsive: true,
            language: { "url": "https://cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json" }
        });
    });
</script>